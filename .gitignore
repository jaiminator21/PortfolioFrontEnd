# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored so it catches every workspace, not just the root and studio/.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.turbo

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# editors — keep shared project settings, drop personal ones
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# sanity studio
/studio/dist
/studio/.sanity
/studio/node_modules

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
