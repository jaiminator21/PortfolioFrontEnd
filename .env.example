# Sanity — safe to expose, these identify a public dataset
NEXT_PUBLIC_SANITY_PROJECT_ID=eplgy6nk
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# Server-only. Needed for draft previews and Live Content.
# Create one at https://sanity.io/manage/project/eplgy6nk/api with Viewer rights.
SANITY_API_READ_TOKEN=

# Canonical site URL, used for sitemap, robots and absolute OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form — Web3Forms. Get a key at https://web3forms.com
# Server-only: the form posts through a Server Action, so this never reaches the browser.
WEB3FORMS_ACCESS_KEY=
